// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime
}

model User {
  id       Int     @id @default(autoincrement())
  publicId String  @unique @default(uuid()) @map("public_id") @db.Uuid
  email    String? @unique
  hash     String?
  addtl    String?
  isAdmin  Boolean @default(false)

  profile  Profile?
  messages Message[]
  groups   ChatParticipant[]

  // Sent friend requests (user is the sender)
  sentRequests FriendRequest[] @relation("SentRequests")

  // Received friend requests( user is the receiver)
  receivedRequests FriendRequest[] @relation("ReceivedRequests")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model FriendRequest {
  id  Int  @id @default(autoincrement())
  publicId  String  @unique @default(uuid()) @map("public_ id") @db.Uuid
  status  FriendRequestStatus  @default(PENDING)
  sentAt  DateTime  @default(now()) @map("sent_at") @db.Timestamptz(6)
  updatedAt  DateTime?  @updatedAt

  // Sender of the request
  senderId  Int
  sender User  @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)

  // Receiver of the request
  receiverId  Int
  receiver  User  @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId]) // Prevent duplicate requests between two same users

}

model ChatGroup {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid()) @map("public_id") @db.Uuid
  name      String    @default("New Chat")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  messages     Message[]
  participants ChatParticipant[]
}

// Join/Junction table for User and ChatGroup
model ChatParticipant {
  id       Int       @id @default(autoincrement())
  publicId String    @unique @default(uuid()) @map("public_id") @db.Uuid
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)

  // Relations
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId Int       @map("group_id")
  group   ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Profile {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid()) @map("public_id") @db.Uuid
  name      String
  pronouns  String
  bio       String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id])
  userId    Int       @map("user_id")

  @@unique([userId])
}

model Message {
  id       Int       @id @default(autoincrement())
  publicId String    @unique @default(uuid()) @map("public_id") @db.Uuid
  sentAt   DateTime  @default(now()) @map("sent_at") @db.Timestamptz(6)
  editedAt DateTime? @updatedAt @map("edited_at") @db.Timestamptz(6)
  content  String

  // Relations
  sentBy   User      @relation(fields: [senderId], references: [id])
  senderId Int       @map("sender_id")
  group    ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId  Int       @map("group_id")

  attachments Attachment[]
}

model Attachment {
  id         Int       @id @default(autoincrement())
  publicId   String    @unique @default(uuid()) @map("public_id") @db.Uuid
  url        String
  name       String    @default("Attachment")
  mimeType   String
  size       Int
  uploadedAt DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  editedAt   DateTime? @updatedAt @map("edited_at") @db.Timestamptz(6)

  messageId Int
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

enum GroupRole {
  ADMIN
  MEMBER
}
