// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime
}

model User {
  id       Int       @id @default(autoincrement())
  publicId String    @unique @default(uuid()) @map("public_id") @db.Uuid
  email    String?   @unique
  hash     String?
  addtl    String?
  isAdmin  Boolean   @default(false)

  profile  Profile?
  messages Message[]
  groups  ChatParticipant[]
}

model ChatGroup {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid()) @map("public_id") @db.Uuid
  name      String    @default("New Chat")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  messages Message[]
  participants  ChatParticipant[]
}

// Join/Junction table for User and ChatGroup
model ChatParticipant {
  id  Int  @id @default(autoincrement())
  publicId  String  @unique @default(uuid()) @map("public_id") @db.Uuid
  role  GroupRole @default(MEMBER)
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  // Relations
  userId  Int  @map("user_id")
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId  Int @map("group_id")
  group  ChatGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Profile {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid()) @map("public_id") @db.Uuid
  name      String
  pronouns  String
  bio       String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id])
  userId    Int       @map("user_id")

  @@unique([userId])
}

model Message {
  id       Int      @id @default(autoincrement())
  publicId String   @unique @default(uuid()) @map("public_id") @db.Uuid
  sentAt   DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)
  editedAt DateTime? @updatedAt @map("edited_at") @db.Timestamptz(6)
  content  String

  // Relations
  sentBy   User      @relation(fields: [senderId], references: [id])
  senderId Int       @map("sender_id")
  group    ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId  Int       @map("group_id")
}

enum GroupRole {
  ADMIN
  MEMBER
}